# Optional Stage 05 server-only advisor model configuration.
# Leave these blank to use the complete deterministic fallback path.
AI_GATEWAY_MODEL=
AI_GATEWAY_API_KEY=
# Vercel normally supplies this automatically in supported environments.
VERCEL_OIDC_TOKEN=

# Supabase public configuration. These values may be exposed to browser clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase/server-only configuration. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# 32+ random bytes used only to HMAC opaque guest credentials before persistence.
MAJUPILOT_GUEST_TOKEN_PEPPER=
