# Phase C server-only AI policy. Competition/demo must use required.
AI_EXECUTION_MODE=required
# Exact IDs are verified against the live Gateway catalogue during preflight.
AI_GATEWAY_MODEL=
# Optional operation-specific exact routes (fall back to AI_GATEWAY_MODEL).
AI_GATEWAY_MODEL_FOLLOW_UP=
AI_GATEWAY_MODEL_RECOMMENDATION_EXPLANATION=
AI_GATEWAY_MODEL_ADVISOR_REVIEW=
AI_GATEWAY_MODEL_CONSULTANT_NOTE=
AI_GATEWAY_MODEL_COPILOT=
AI_GATEWAY_API_KEY=
# Vercel normally supplies this automatically in supported environments.
VERCEL_OIDC_TOKEN=
# Bounded server defaults; override only after cost/security review.
AI_TIMEOUT_MS_FOLLOW_UP=20000
AI_MAX_INPUT_TOKENS_FOLLOW_UP=1200
AI_MAX_OUTPUT_TOKENS_FOLLOW_UP=320
AI_MAX_RETRIES_FOLLOW_UP=1
AI_RATE_LIMIT_PER_MINUTE_FOLLOW_UP=6
AI_MAX_COST_USD_FOLLOW_UP=0.02
AI_TIMEOUT_MS_RECOMMENDATION_EXPLANATION=25000
AI_MAX_INPUT_TOKENS_RECOMMENDATION_EXPLANATION=5000
AI_MAX_OUTPUT_TOKENS_RECOMMENDATION_EXPLANATION=1000
AI_MAX_RETRIES_RECOMMENDATION_EXPLANATION=1
AI_RATE_LIMIT_PER_MINUTE_RECOMMENDATION_EXPLANATION=8
AI_MAX_COST_USD_RECOMMENDATION_EXPLANATION=0.05
AI_TIMEOUT_MS_CONSULTANT_NOTE=30000
AI_MAX_INPUT_TOKENS_CONSULTANT_NOTE=5000
AI_MAX_OUTPUT_TOKENS_CONSULTANT_NOTE=700
AI_MAX_RETRIES_CONSULTANT_NOTE=1
AI_RATE_LIMIT_PER_MINUTE_CONSULTANT_NOTE=10
AI_MAX_COST_USD_CONSULTANT_NOTE=0.05
AI_TIMEOUT_MS_COPILOT=60000
AI_MAX_INPUT_TOKENS_COPILOT=10000
AI_MAX_OUTPUT_TOKENS_COPILOT=1500
AI_MAX_RETRIES_COPILOT=1
AI_RATE_LIMIT_PER_MINUTE_COPILOT=12
AI_MAX_COST_USD_COPILOT=0.10
AI_DAILY_COST_USD=2

# Supabase public configuration. These values may be exposed to browser clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase/server-only configuration. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# 32+ random bytes used only to HMAC opaque guest credentials before persistence.
MAJUPILOT_GUEST_TOKEN_PEPPER=
